# Flask Configuration
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Selenium Configuration
CHROME_HEADLESS=True
CHROME_WINDOW_SIZE=1920,1080
SELENIUM_TIMEOUT=10

# CAPTCHA Solving Configuration
CAPTCHA_TIMEOUT=30
MAX_RETRY_ATTEMPTS=3
OCR_CONFIG=--oem 3 --psm 8 -c tessedit_char_whitelist=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz

# Database Configuration
DATABASE_PATH=court_data.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Court Website Configuration
COURT_BASE_URL=https://delhihighcourt.nic.in/
REQUEST_DELAY=2
MAX_SEARCH_TIME=300

# Security
SECRET_KEY=your-secret-key-here-change-in-production