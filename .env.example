# Google reCAPTCHA Configuration
# Get your keys from: https://www.google.com/recaptcha/admin/create

# reCAPTCHA Site Key (public key)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# reCAPTCHA Secret Key (private key)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True